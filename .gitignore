# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw source clips for the silhouette pipeline (often huge, locally-only)
/raw/
!/raw/.gitkeep

# silhouette pipeline writes locally before pushing to Supabase Storage.
# Treat these as build artifacts; the live versions live in Supabase.
/public/videos/*.mp4
/public/posters/*.jpg
!/public/videos/.gitkeep
!/public/posters/.gitkeep
